<!--
  Rules for yubihsm-auditor events delivered via the agent's <localfile
  log_format="json"> (see ../agent-localfile.conf.example), as opposed to the
  syslog-to-manager path (rules/local_rules.xml + decoders/local_decoder.xml).

  Install ONE of the two rule sets, matching whichever path you configured.
  Both use the same bare field names (e.g. <field name="event_type">, no
  prefix) - Wazuh's generic `json` decoder used for <log_format>json</log_format>
  localfile input stores decoded keys as top-level dynamic fields for rule
  matching purposes, the same as the custom decoder on the syslog path. The
  `data.*` nesting you'll see in archives.json/alerts.json is just how the
  *output* is serialized, not how <field name="..."> addresses them -
  verified with `wazuh-logtest` against real output (Phase 2 prints bare key
  names like `collector: '...'`, not `data.collector`).

  Install on the Wazuh manager as
  /var/ossec/etc/rules/local_rules-agent.xml (or merge into your existing
  file), then restart the manager. No corresponding decoder is needed: Wazuh
  parses <log_format>json</log_format> localfile input natively. Rule IDs
  below (100330-100340) are offset from local_rules.xml's (100300-100310)
  so the two can coexist if you ever run both paths - but neither range is
  a guarantee for your installation specifically. Before installing, check
  what's already taken:
    grep -rhoE '<rule id="[0-9]+"' /var/ossec/etc/rules/*.xml \
      | grep -oE '[0-9]+' | sort -n | uniq
  and renumber (every id="...", if_sid, if_matched_sid, and same_field
  reference) if 100330-100340 collides with something you already have.
-->
<group name="yubihsm,hsm,">

  <rule id="100330" level="3">
    <decoded_as>json</decoded_as>
    <field name="collector">^yubihsm-auditor$</field>
    <description>YubiHSM audit event: $(device_name) $(event_type)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100331" level="0">
    <if_sid>100330</if_sid>
    <field name="event_type">^device_status$</field>
    <description>YubiHSM $(device_name): heartbeat (log $(log_store_percent_used)% full)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100332" level="10">
    <if_sid>100330</if_sid>
    <field name="event_type">^unlogged_events$</field>
    <description>YubiHSM $(device_name): audit gap - device recorded events it could not log</description>
    <group>audit_gap,</group>
  </rule>

  <rule id="100333" level="10">
    <if_sid>100330</if_sid>
    <field name="chain_status">^mismatch$</field>
    <description>YubiHSM $(device_name): audit log hash chain mismatch on entry $(log_item)</description>
    <group>audit_gap,</group>
  </rule>

  <rule id="100334" level="7">
    <if_sid>100330</if_sid>
    <field name="event_type">^command$</field>
    <field name="key_management">^true$</field>
    <description>YubiHSM $(device_name): key management operation $(command) by 0x$(session_key_id_hex) on 0x$(target_key_id_hex)</description>
    <group>key_management,</group>
  </rule>

  <rule id="100335" level="5">
    <if_sid>100330</if_sid>
    <field name="event_type">^command$</field>
    <field name="result">^error$</field>
    <description>YubiHSM $(device_name): $(command) failed ($(result_name)) for 0x$(session_key_id_hex)</description>
  </rule>

  <rule id="100336" level="5">
    <if_sid>100335</if_sid>
    <field name="result_name">^device_insufficient_permissions$</field>
    <description>YubiHSM $(device_name): permission denied on $(command) for 0x$(session_key_id_hex)</description>
  </rule>

  <!--
    Correlation rule: fires when rule 100336 itself has matched 5+ times
    within 300s for the same session_key_id. Frequency/context rules in
    Wazuh must reference the repeated rule via if_matched_sid (a plain
    if_sid is rejected at load time) - the field filter that narrows which
    events count belongs on the referenced rule (100336), not here.
  -->
  <rule id="100337" level="8" frequency="5" timeframe="300">
    <if_matched_sid>100336</if_matched_sid>
    <same_field>session_key_id</same_field>
    <description>YubiHSM $(device_name): repeated permission denials on 0x$(session_key_id_hex) - possible capability probing</description>
    <group>authentication_failures,</group>
  </rule>

  <!--
    Three plain rules instead of one with `(a|b|c)` alternation: OS_Regex
    (Wazuh's <field> matcher) isn't full PCRE and has been unreliable with
    parenthesized alternation groups in practice. Anchored character classes
    with no grouping are the safe subset - every one of these needs its own
    rule id since a rule can't OR multiple <field> patterns together.
  -->
  <rule id="100338" level="12">
    <if_sid>100330</if_sid>
    <field name="log_store_percent_used">^100$</field>
    <description>YubiHSM $(device_name): audit log buffer over 75% full ($(log_store_percent_used)%) - collector may be falling behind</description>
  </rule>

  <rule id="100339" level="12">
    <if_sid>100330</if_sid>
    <field name="log_store_percent_used">^[89][0-9]$</field>
    <description>YubiHSM $(device_name): audit log buffer over 75% full ($(log_store_percent_used)%) - collector may be falling behind</description>
  </rule>

  <rule id="100340" level="12">
    <if_sid>100330</if_sid>
    <field name="log_store_percent_used">^7[6-9]$</field>
    <description>YubiHSM $(device_name): audit log buffer over 75% full ($(log_store_percent_used)%) - collector may be falling behind</description>
  </rule>

</group>
