# Filebeat snippet for shipping yubihsm-auditor's `file` output into
# Elasticsearch or OpenSearch. Merge into your filebeat.yml.
#
# Point yubihsm-auditor at a plain JSON-lines file:
#   [output]
#   type = "file"
#   path = "/var/log/yubihsm/audit.jsonl"

filebeat.inputs:
  - type: filestream
    id: yubihsm-audit
    paths:
      - /var/log/yubihsm/audit.jsonl*
    parsers:
      - ndjson:
          keys_under_root: true
          add_error_key: true
          overwrite_keys: true

# Load the ingest pipeline and mappings once (see docs/siem-integrations.md,
# "Elastic / OpenSearch"), then point Filebeat at the index and pipeline:
output.elasticsearch:
  hosts: ["https://elasticsearch.example.com:9200"]
  index: "yubihsm-audit-%{+yyyy.MM.dd}"
  pipeline: "yubihsm-audit"

setup.template.enabled: false # the project's own index template owns mappings
