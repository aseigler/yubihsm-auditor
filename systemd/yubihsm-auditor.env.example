# Copy to /etc/yubihsm-auditor/yubihsm-auditor.env, fill in real values,
# then: chown yubihsm-auditor:yubihsm-auditor /etc/yubihsm-auditor/yubihsm-auditor.env
#       chmod 600 /etc/yubihsm-auditor/yubihsm-auditor.env
# Referenced by systemd's EnvironmentFile= in yubihsm-auditor.service.
# Names must match the *_env keys used in yubihsm-auditor.toml.

HSM_IAD1_01_PASSWORD=changeme
# HSM_IAD1_02_PASSWORD=changeme
# SPLUNK_HEC_TOKEN=changeme
